# ============================================================
# QuantFlow Terminal — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# --- App ---
APP_ENV=development                         # development | staging | production
APP_SECRET_KEY=change-me-32-chars-minimum
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR

# --- Database (PostgreSQL + TimescaleDB) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=quantflow
POSTGRES_USER=quantflow
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://quantflow:changeme@postgres:5432/quantflow
DATABASE_URL_SYNC=postgresql://quantflow:changeme@postgres:5432/quantflow

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379/0

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=quantflow
RABBITMQ_PASSWORD=changeme
RABBITMQ_URL=amqp://quantflow:changeme@rabbitmq:5672/

# --- JWT (RS256 — generate with: openssl genrsa -out private.pem 2048) ---
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# --- Celery ---
CELERY_BROKER_URL=amqp://quantflow:changeme@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/1

# --- Market Data Sources ---
POLYGON_API_KEY=your_polygon_api_key
POLYGON_WS_URL=wss://socket.polygon.io/options
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
FRED_API_KEY=your_fred_api_key
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# --- Frontend URLs ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
ALLOWED_ORIGINS=http://localhost:3000,https://quantflow.io

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_PORT=9090
SENTRY_DSN=

# --- Feature Flags ---
ENABLE_AI_REPORTS=true
ENABLE_BACKTESTING=true
ENABLE_FUTURES_FLOW=true
